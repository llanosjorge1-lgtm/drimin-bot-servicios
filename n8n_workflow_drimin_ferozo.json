        "subject": "=🚫 Cita Cancelada - {{ $json.clientName || 'Cliente' }} | Drimin Services",
        "html": "=<div style=\"font-family: 'Segoe UI', Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<div style=\"background: linear-gradient(135deg, #991b1b, #dc2626); color: #fff; padding: 24px 30px; border-radius: 12px 12px 0 0;\">\n<h2 style=\"margin: 0;\">🚫 Consulta Jurídica Cancelada</h2>\n<p style=\"margin: 8px 0 0; opacity: 0.85;\">Un cliente ha cancelado su cita programada</p>\n</div>\n<div style=\"background: #fef2f2; padding: 24px 30px; border: 1px solid #fecaca;\">\n<table style=\"width: 100%; border-collapse: collapse;\">\n<tr><td style=\"padding: 10px; font-weight: bold; color: #334155; border-bottom: 1px solid #e2e8f0;\">👤 Cliente</td><td style=\"padding: 10px; border-bottom: 1px solid #e2e8f0;\">{{ $json.clientName }}</td></tr>\n<tr><td style=\"padding: 10px; font-weight: bold; color: #334155; border-bottom: 1px solid #e2e8f0;\">🆔 ID Cita</td><td style=\"padding: 10px; border-bottom: 1px solid #e2e8f0;\">{{ $json.appointmentId || 'N/A' }}</td></tr>\n</table>\n<p style=\"margin-top: 16px; padding: 12px; background: #fee2e2; border-radius: 8px; color: #991b1b;\">⚠️ El bloque horario ha sido liberado. Se adjunta .ics de cancelación para Outlook.</p>\n</div>\n<div style=\"background: #0f172a; color: #94a3b8; padding: 16px 30px; border-radius: 0 0 12px 12px; font-size: 12px; text-align: center;\">Drimin Services SpA | Sistema Autónomo</div>\n</div>",
