{
  "name": "Drimin Services - Workflow Autónomo Ferozo + Outlook (Servicios Jurídicos 24/7)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "drimin-consulta-event",
        "options": {
          "responseMode": "onReceived",
          "responseData": "allEntries"
        }
      },
      "name": "1. Webhook Evento Drimin",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 400],
      "webhookId": "drimin-consulta-event"
    },

    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.body?.event || $json.event }}", "rightValue": "MEETING_BOOKED", "operator": { "type": "string", "operation": "equals" } }]
              },
              "renameOutput": true,
              "outputLabel": "Cita Agendada"
            },
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.body?.event || $json.event }}", "rightValue": "MEETING_CANCELED", "operator": { "type": "string", "operation": "equals" } }]
              },
              "renameOutput": true,
              "outputLabel": "Cita Cancelada"
            },
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.body?.event || $json.event }}", "rightValue": "INCIDENT_REPORTED", "operator": { "type": "string", "operation": "equals" } }]
              },
              "renameOutput": true,
              "outputLabel": "Incidencia Legal"
            },
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.body?.event || $json.event }}", "rightValue": "PAYMENT_RECEIPT_SUBMITTED", "operator": { "type": "string", "operation": "equals" } }]
              },
              "renameOutput": true,
              "outputLabel": "Pago Recibido"
            }
          ]
        },
        "options": {
          "fallbackOutput": "none"
        }
      },
      "name": "2. Router por Tipo de Evento",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [500, 400]
    },

    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Generar archivo ICS para invitación de calendario Outlook\nconst data = $input.first().json;\nconst body = data.body || data;\n\nconst startIso = body.startIso || '';\nconst endIso = body.endIso || '';\nconst clientName = body.clientName || 'Cliente';\nconst unitNumber = body.unitNumber || 'Empresa';\nconst meetingReason = body.meetingReason || 'Consulta Jurídica';\nconst summary = body.summary || body.calendarSummary || `Consulta Minera: ${clientName} - ${unitNumber}`;\nconst dateTime = body.dateTime || '';\nconst voucherCode = body.voucherCode || 'N/A';\nconst adminEmail = body.adminEmail || 'felipe.herrera@driminservices.cl';\n\n// Generar UID único para el evento\nconst uid = `drimin-${Date.now()}-${Math.random().toString(36).substr(2, 6)}@driminservices.cl`;\n\n// Convertir ISO a formato ICS (YYYYMMDDTHHMMSS)\n// Input: 2026-09-15T10:00:00-03:00\nfunction isoToIcs(iso) {\n  if (!iso) return '';\n  return iso.replace(/[-:]/g, '').split(/[.+]/)[0].replace(/(\\d{8}T\\d{6}).*/, '$1');\n}\n\nconst dtStart = isoToIcs(startIso);\nconst dtEnd = isoToIcs(endIso);\nconst now = new Date().toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';\n\nconst icsContent = [\n  'BEGIN:VCALENDAR',\n  'VERSION:2.0',\n  'PRODID:-//Drimin Services SpA//Bot Autonomo v2.0//ES',\n  'CALSCALE:GREGORIAN',\n  'METHOD:REQUEST',\n  'BEGIN:VTIMEZONE',\n  'TZID:America/Santiago',\n  'BEGIN:STANDARD',\n  'DTSTART:19700404T000000',\n  'RRULE:FREQ=YEARLY;BYMONTH=4;BYDAY=1SA',\n  'TZOFFSETFROM:-0300',\n  'TZOFFSETTO:-0400',\n  'TZNAME:CLT',\n  'END:STANDARD',\n  'BEGIN:DAYLIGHT',\n  'DTSTART:19700905T000000',\n  'RRULE:FREQ=YEARLY;BYMONTH=9;BYDAY=1SA',\n  'TZOFFSETFROM:-0400',\n  'TZOFFSETTO:-0300',\n  'TZNAME:CLST',\n  'END:DAYLIGHT',\n  'END:VTIMEZONE',\n  'BEGIN:VEVENT',\n  `UID:${uid}`,\n  `DTSTAMP:${now}`,\n  `DTSTART;TZID=America/Santiago:${dtStart}`,\n  `DTEND;TZID=America/Santiago:${dtEnd}`,\n  `SUMMARY:${summary}`,\n  `DESCRIPTION:Consulta jurídica coordinada automáticamente por Drimin Bot.\\\\nCliente: ${clientName}\\\\nEmpresa/Faena: ${unitNumber}\\\\nAsunto: ${meetingReason}\\\\nFecha: ${dateTime}\\\\nVoucher QR: ${voucherCode}`,\n  `ORGANIZER;CN=Abg. Felipe Herrera:mailto:felipe.herrera@driminservices.cl`,\n  `ATTENDEE;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;CN=Abg. Felipe Herrera:mailto:felipe.herrera@driminservices.cl`,\n  'STATUS:CONFIRMED',\n  'PRIORITY:5',\n  `LOCATION:Oficinas Drimin Services SpA`,\n  'BEGIN:VALARM',\n  'TRIGGER:-PT2H',\n  'ACTION:DISPLAY',\n  `DESCRIPTION:Recordatorio: ${summary}`,\n  'END:VALARM',\n  'BEGIN:VALARM',\n  'TRIGGER:-PT30M',\n  'ACTION:DISPLAY',\n  `DESCRIPTION:En 30 min: ${summary}`,\n  'END:VALARM',\n  'END:VEVENT',\n  'END:VCALENDAR'\n].join('\\r\\n');\n\n// Convertir a binary para adjuntar como .ics\nconst binaryData = Buffer.from(icsContent, 'utf-8');\n\nreturn [{\n  json: {\n    ...body,\n    icsUid: uid,\n    icsGenerated: true\n  },\n  binary: {\n    icsFile: {\n      data: binaryData.toString('base64'),\n      mimeType: 'text/calendar; method=REQUEST',\n      fileName: `consulta-drimin-${clientName.replace(/\\s+/g, '-').toLowerCase()}.ics`,\n      fileExtension: 'ics'\n    }\n  }\n}];"
      },
      "name": "3. Generar ICS Calendario Outlook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 0]
    },

    {
      "parameters": {
        "fromEmail": "felipe.herrera@driminservices.cl",
        "toEmail": "felipe.herrera@driminservices.cl",
        "subject": "=⚖️📅 Nueva Consulta Jurídica Agendada - {{ $json.clientName || 'Cliente' }} | {{ $json.unitNumber || 'Empresa' }}",
        "html": "=<div style=\"font-family: 'Segoe UI', Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<div style=\"background: linear-gradient(135deg, #0f172a, #1e293b); color: #fff; padding: 24px 30px; border-radius: 12px 12px 0 0;\">\n<h2 style=\"margin: 0; color: #fbbf24;\">⚖️📅 Nueva Consulta Jurídica Agendada</h2>\n<p style=\"margin: 8px 0 0; opacity: 0.85;\">Drimin Services - Sistema Autónomo de Atención 24/7</p>\n</div>\n<div style=\"background: #f8fafc; padding: 24px 30px; border: 1px solid #e2e8f0;\">\n<table style=\"width: 100%; border-collapse: collapse;\">\n<tr><td style=\"padding: 10px; font-weight: bold; color: #334155; border-bottom: 1px solid #e2e8f0; width: 40%;\">🏢 Organización</td><td style=\"padding: 10px; border-bottom: 1px solid #e2e8f0;\">Drimin Services SpA</td></tr>\n<tr><td style=\"padding: 10px; font-weight: bold; color: #334155; border-bottom: 1px solid #e2e8f0;\">👤 Cliente</td><td style=\"padding: 10px; border-bottom: 1px solid #e2e8f0;\">{{ $json.clientName }}</td></tr>\n<tr><td style=\"padding: 10px; font-weight: bold; color: #334155; border-bottom: 1px solid #e2e8f0;\">🏗️ Empresa / Faena</td><td style=\"padding: 10px; border-bottom: 1px solid #e2e8f0;\">{{ $json.unitNumber }}</td></tr>\n<tr><td style=\"padding: 10px; font-weight: bold; color: #334155; border-bottom: 1px solid #e2e8f0;\">📋 Asunto Legal</td><td style=\"padding: 10px; border-bottom: 1px solid #e2e8f0;\">{{ $json.meetingReason }}</td></tr>\n<tr><td style=\"padding: 10px; font-weight: bold; color: #334155; border-bottom: 1px solid #e2e8f0;\">📅 Fecha y Hora</td><td style=\"padding: 10px; border-bottom: 1px solid #e2e8f0;\">{{ $json.dateTime }}</td></tr>\n<tr><td style=\"padding: 10px; font-weight: bold; color: #334155; border-bottom: 1px solid #e2e8f0;\">🎟️ Código Pase QR</td><td style=\"padding: 10px; border-bottom: 1px solid #e2e8f0;\"><code>{{ $json.voucherCode || 'N/A' }}</code></td></tr>\n</table>\n<p style=\"margin-top: 16px; padding: 12px; background: #dbeafe; border-radius: 8px; color: #1e40af;\">📌 Se adjunta archivo .ics para agregar automáticamente a su Calendario de Outlook. Haga doble clic en el adjunto para aceptar la cita.</p>\n</div>\n<div style=\"background: #0f172a; color: #94a3b8; padding: 16px 30px; border-radius: 0 0 12px 12px; font-size: 12px; text-align: center;\">Drimin Services SpA | RUT 76.543.210-9 | felipe.herrera@driminservices.cl</div>\n</div>",
        "options": {
          "attachments": "icsFile"
        }
      },
      "name": "4. Email Admin + Evento Outlook",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1100, 0],
      "credentials": {
        "smtp": {
          "id": "smtp-cred-ferozo-drimin",
          "name": "SMTP Ferozo Drimin Services"
        }
      }
    },

    {
      "parameters": {
        "fromEmail": "felipe.herrera@driminservices.cl",
        "toEmail": "={{ $json.adminEmail || 'felipe.herrera@driminservices.cl' }}",
        "subject": "=✅ Confirmación de su Consulta Jurídica - Drimin Services | {{ $json.dateTime }}",
        "html": "=<div style=\"font-family: 'Segoe UI', Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<div style=\"background: linear-gradient(135deg, #0f172a, #1e293b); color: #fff; padding: 24px 30px; border-radius: 12px 12px 0 0;\">\n<h2 style=\"margin: 0; color: #fbbf24;\">✅ Su Consulta Jurídica ha sido Agendada</h2>\n<p style=\"margin: 8px 0 0; opacity: 0.85;\">Drimin Services SpA - Servicios Jurídicos Especializados</p>\n</div>\n<div style=\"background: #f8fafc; padding: 24px 30px; border: 1px solid #e2e8f0;\">\n<p>Estimado/a <strong>{{ $json.clientName }}</strong>,</p>\n<p>Le confirmamos que su consulta jurídica ha sido agendada exitosamente:</p>\n<table style=\"width: 100%; border-collapse: collapse; margin: 16px 0;\">\n<tr><td style=\"padding: 10px; font-weight: bold; color: #334155; border-bottom: 1px solid #e2e8f0;\">📅 Fecha y Hora</td><td style=\"padding: 10px; border-bottom: 1px solid #e2e8f0;\">{{ $json.dateTime }}</td></tr>\n<tr><td style=\"padding: 10px; font-weight: bold; color: #334155; border-bottom: 1px solid #e2e8f0;\">📋 Asunto</td><td style=\"padding: 10px; border-bottom: 1px solid #e2e8f0;\">{{ $json.meetingReason }}</td></tr>\n<tr><td style=\"padding: 10px; font-weight: bold; color: #334155; border-bottom: 1px solid #e2e8f0;\">👨‍⚖️ Abogado</td><td style=\"padding: 10px; border-bottom: 1px solid #e2e8f0;\">Abg. Felipe Herrera</td></tr>\n<tr><td style=\"padding: 10px; font-weight: bold; color: #334155; border-bottom: 1px solid #e2e8f0;\">🎟️ Pase QR</td><td style=\"padding: 10px; border-bottom: 1px solid #e2e8f0;\"><code>{{ $json.voucherCode }}</code></td></tr>\n</table>\n<p style=\"padding: 12px; background: #fef3c7; border-radius: 8px; color: #92400e;\">⚠️ Le recordaremos antes de su cita. Conserve su código QR para el ingreso.</p>\n</div>\n<div style=\"background: #0f172a; color: #94a3b8; padding: 16px 30px; border-radius: 0 0 12px 12px; font-size: 12px; text-align: center;\">Drimin Services SpA | +56 9 8877 6655 | felipe.herrera@d