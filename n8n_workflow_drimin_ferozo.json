    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Generar archivo ICS de CANCELACIÓN para Outlook\nconst data = $input.first().json;\nconst body = data.body || data;\n\nconst clientName = body.clientName || 'Cliente';\nconst appointmentId = body.appointmentId || 'N/A';\nconst adminEmail = body.adminEmail || 'felipe.herrera@driminservices.cl';\n\n// UID basado en el appointmentId para que Outlook lo reconozca\nconst uid = `drimin-cancel-${appointmentId}-${Date.now()}@driminservices.cl`;\nconst now = new Date().toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';\n\nconst icsContent = [\n  'BEGIN:VCALENDAR',\n  'VERSION:2.0',\n  'PRODID:-//Drimin Services SpA//Bot Autonomo v2.0//ES',\n  'CALSCALE:GREGORIAN',\n  'METHOD:CANCEL',\n  'BEGIN:VEVENT',\n  `UID:${uid}`,\n  `DTSTAMP:${now}`,\n  `DTSTART:${now}`,\n  `DTEND:${now}`,\n  `SUMMARY:CANCELADA - Consulta con ${clientName}`,\n  `DESCRIPTION:La consulta jurídica con ${clientName} ha sido cancelada por el cliente.`,\n  'ORGANIZER;CN=Abg. Felipe Herrera:mailto:felipe.herrera@driminservices.cl',\n  'STATUS:CANCELLED',\n  'PRIORITY:1',\n  'END:VEVENT',\n  'END:VCALENDAR'\n].join('\\r\\n');\n\nconst binaryData = Buffer.from(icsContent, 'utf-8');\n\nreturn [{\n  json: { ...body, icsCanceled: true },\n  binary: {\n    icsFile: {\n      data: binaryData.toString('base64'),\n      mimeType: 'text/calendar; method=CANCEL',\n      fileName: `cancelacion-drimin-${clientName.replace(/\\s+/g, '-').toLowerCase()}.ics`,\n      fileExtension: 'ics'\n    }\n  }\n}];"
      },
