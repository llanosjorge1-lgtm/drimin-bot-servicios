        "end": "={{ $json.body?.endIso || $json.endIso }}",
        "summary": "={{ $json.body?.summary || $json.summary || $json.body?.calendarSummary || $json.calendarSummary || ('Consulta Minera: ' + ($json.body?.clientName || $json.clientName || 'Cliente') + ' - Empresa: ' + ($json.body?.unitNumber || $json.unitNumber || 'General') + ' - ' + ($json.body?.meetingReason || $json.meetingReason || 'Consulta Jurídica')) }}",
