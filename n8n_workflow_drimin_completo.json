          "attendees": ["felipe.herrera@driminservices.cl"],
          "conferenceData": {
            "createRequest": {
              "requestId": "={{ 'drimin-' + Date.now() }}",
              "conferenceSolutionKey": { "type": "hangoutsMeet" }
            }
          }
        }
      },
